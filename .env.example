# Leave empty to run the canned demo (no API key required).
# Set DEMO_MODE=0 and provide a key to use a live model.

# DEMO_MODE=1

# OpenAI
# OPENAI_API_KEY=sk-...

# Or Vercel AI Gateway
# AI_GATEWAY_API_KEY=...

# Optional override. Defaults to gpt-4o-mini / openai/gpt-4o-mini.
# OPENAI_MODEL=gpt-4o-mini
